# API
APP_NAME=MyCup API
DEBUG=true

# Database
DATABASE_URL=postgresql://mycup_user:mycup_password@localhost:5432/mycup

# JWT (32자 이상의 임의 문자열로 변경)
SECRET_KEY=replace-with-a-random-secret-key-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OpenAI
OPENAI_API_KEY=

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8000/api/v1/auth/kakao/callback
